# Copy only if .env does not exist. Never overwrite existing credentials.
# Queries pass through our server and the selected upstream search engines.
# Reports, drafts and reminders are saved in the browser.
SERP_PROVIDER=searxng
ALLOW_SEARCH_RELAY=false
CLOUD_AI_ENABLED=false

# Optional opt-in AI drafting ("Draft with AI"), separate from CLOUD_AI_ENABLED.
# Off by default. Each draft needs the visitor's consent; prompts and drafts
# are not stored. Paste the provider key only in private .env / Wrangler secrets.
AI_DRAFTING_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-5-mini
AI_PROVIDER_NAME=OpenAI
AI_API_KEY=
AI_DRAFTS_PER_IP_DAY=10
AI_DAILY_USD_LIMIT=5

# Optional Google backup. SearXNG remains the default provider.
# Paste only in private .env. The app asks for consent before using SerpApi.
GOOGLE_BACKUP_PROVIDER=serpapi
SERPAPI_API_KEY=
# Applies to backup calls across public and operator use; adjust for your plan.
GOOGLE_BACKUP_DAILY_LIMIT=50
# Optional USD estimate per 1,000 calls; blank means unknown, not free.
GOOGLE_BACKUP_COST_PER_1K=

# Local preview: connect an SSH tunnel to the dedicated VPS service first.
SEARXNG_URL=http://127.0.0.1:8890
SEARXNG_ALLOW_LOOPBACK_HTTP=true
SEARXNG_ENGINES=google,bing,google cse
# Remote HTTPS deployments require a protected gateway and a server-only token.
SEARXNG_TOKEN=
# Alternative HTTPS proxy authentication. Server-only; never include in browser code.
SEARXNG_PROXY_KEY=
# Alternative for an HTTPS SearXNG gateway protected by Cloudflare Access.
# Set both together; never include either in browser assets.
SEARXNG_ACCESS_CLIENT_ID=
SEARXNG_ACCESS_CLIENT_SECRET=

# Bound upstream requests. This is an allowance, not a coverage guarantee.
MAX_QUERIES=24
DAILY_SERP_LIMIT=300
# SearXNG itself has no per-query API charge; hosting costs are separate.
SERP_COST_PER_1K=0

# Operator dashboard and daily public quota. Generate distinct random secrets
# (at least 32 characters) and never put either value in public assets.
OPERATOR_ACCESS_KEY=
RATE_LIMIT_SECRET=
# Enable only for loopback preview; production must use Cloudflare client IPs.
LOCAL_DEVELOPMENT=false

# Server abuse protection. Turnstile can be disabled only on explicit loopback
# development (LOCAL_DEVELOPMENT=true), where no Cloudflare widget is loaded.
ABUSE_PROTECTION_ENABLED=true
TURNSTILE_ENABLED=true
TURNSTILE_HOSTNAME=app.123reputationmanagement.org
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Gmail / Outlook sending. See EMAIL-CONNECTION-SETUP.md.
EMAIL_APP_ORIGIN=http://127.0.0.1:8788
# Separate random 32-byte key represented as 64 hex characters. Server only.
EMAIL_TOKEN_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
